# Per-sample dependencies (each sample is its own Eleventy project)
node_modules/
samples/*/node_modules/

# NOTE: each sample's _site/ build output IS committed on purpose — cPanel git
# deploy copies it to public_html/samples/<niche>/. Rebuild with `npm run build`
# inside the sample and commit it alongside source changes.

# kit-test (template-kit cPanel proof): content.json is LIVE/mutable buyer
# data (falls back to content.original.json when absent — see lib/content.php)
# and uploads/ is buyer-uploaded images. Neither belongs in a public repo.
kit-test/content.json
kit-test/uploads/

# Same live/mutable-data rule for any template-kit stamp under demos/ —
# uploads/ + a live-edited content.json shouldn't ship in the repo, and
# lib/.rate-limit.json + lib/.login-attempts.json are runtime state
# (contact-form throttling, edit-login lockout), not stamp output.
# demos/*/.kit-stamp.json IS committed on purpose — it's what lets
# scaffold/update-stamp.js re-stamp a demo later, not secret or mutable.
demos/*/content.json
demos/*/uploads/
demos/*/backups/
**/lib/.rate-limit.json
**/lib/.login-attempts.json

# OS / editor cruft
.DS_Store
Thumbs.db
