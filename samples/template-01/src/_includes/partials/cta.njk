  <!-- CALL-TO-ACTION BAND -->
  <section class="cta-band">
    <div class="container cta-centered">
      <div class="cta-heading-row">
        <span class="cta-arrow cta-arrow--left" aria-hidden="true">
          <svg width="48" height="28" viewBox="0 0 48 28" fill="none"><path d="M0 14H40M40 14L28 4M40 14L28 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg width="48" height="28" viewBox="0 0 48 28" fill="none"><path d="M0 14H40M40 14L28 4M40 14L28 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2>Garage door trouble?<br>We can usually be there today.</h2>
        <span class="cta-arrow cta-arrow--right" aria-hidden="true">
          <svg width="48" height="28" viewBox="0 0 48 28" fill="none"><path d="M48 14H8M8 14L20 4M8 14L20 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg width="48" height="28" viewBox="0 0 48 28" fill="none"><path d="M48 14H8M8 14L20 4M8 14L20 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
      <p>Free estimates · Upfront pricing · Serving all of {{ site.areaServed }}</p>
      <div class="cta-actions">
        <a href="tel:{{ site.phoneHref }}" class="btn btn--accent btn--lg">Call {{ site.phone }}</a>
        <a href="{{ '/contact/' | url }}" class="btn btn--ghost btn--lg">Request a Free Quote</a>
      </div>
    </div>
  </section>
