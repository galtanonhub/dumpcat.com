  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Ready to get it done? Call or request a quote.</h2>
        <p>Licensed · Insured · Permitted · Serving {{ site.areaServed }}</p>
      </div>
      <div class="cta-actions">
        <a href="tel:{{ site.phoneHref }}" class="btn btn--dark btn--lg">Call {{ site.phone }}</a>
        <a href="{{ '/contact/' | url }}" class="btn btn--outline-dark btn--lg">Request a Quote</a>
      </div>
    </div>
  </section>
