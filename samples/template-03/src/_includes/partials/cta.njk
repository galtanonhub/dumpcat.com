  <section class="cta-band">
    <div class="container cta-centered">
      <h2>Ready to stop letting bugs ruin your backyard?</h2>
      <p>Free estimates · Permitted &amp; inspected · Serving all of {{ site.areaServed }}</p>
      <div class="cta-actions">
        <a href="tel:{{ site.phoneHref }}" class="btn btn--accent btn--lg">Call {{ site.phone }}</a>
        <a href="{{ '/contact/' | url }}" class="btn btn--ghost btn--lg">Get a Free Estimate</a>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-top:16px;">
        <span class="cta-badge">✓ Permits Handled For You</span>
        <span class="cta-badge">✓ Florida Building Code Compliant</span>
        <span class="cta-badge">✓ {{ site.rating }}★ from {{ site.reviewCount }}+ reviews</span>
      </div>
    </div>
  </section>
