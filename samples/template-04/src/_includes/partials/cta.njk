  <section class="cta-band">
    <div class="container cta-centered">
      <h2>Have a job for me?</h2>
      <p>Call or text — I answer my own phone, usually same day.</p>
      <div class="cta-actions">
        <a href="tel:{{ site.phoneHref }}" class="btn btn--rust btn--lg">Call {{ site.phone }}</a>
        <a href="{{ '/contact/' | url }}" class="btn btn--ghost btn--lg">Send a Message</a>
      </div>
    </div>
  </section>
