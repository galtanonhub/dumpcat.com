---
layout: layouts/base.njk
title: Contact
permalink: /contact/
description: "Contact Your Name Handyman for home repairs in East Orlando. Call (407) 555-0217 or send a message — I respond same day."
---

  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contact</span>
      </nav>
      <span class="eyebrow">Get in Touch</span>
      <h1>Let's Talk About Your Job</h1>
      <p class="page-lead">Call or text for fastest response. Or fill out the form and I'll get back to you the same day.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <div class="contact-personal">
          <h2>Just call me.</h2>
          <a href="tel:{{ site.phoneHref }}" class="contact-big-phone">{{ site.phone }}</a>
          <p class="contact-hours">{{ site.hours }}<br>{{ site.hoursNote }}</p>

          <ul class="contact-list">
            <li>
              <span class="contact-label">Email</span>
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </li>
            <li>
              <span class="contact-label">Based in</span>
              {{ site.city }}, FL {{ site.zip }}
            </li>
            <li>
              <span class="contact-label">Service area</span>
              {{ site.areaServed }} &amp; nearby neighborhoods
            </li>
          </ul>

          <div class="contact-promise">
            I answer my own phone. If I'm on a job, I'll call back within a couple hours.
          </div>
        </div>
      </div>

      <div class="contact-form-wrap">
        <!-- FORM ACTION: replace action="#" with your endpoint before launch.
             Formspree: action="https://formspree.io/f/YOUR_ID" -->
        <form class="quote-form" method="POST" action="#" novalidate>
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
          <h2 style="font-size:1.5rem;margin-bottom:20px;">Tell me about the job</h2>
          <div class="field-row">
            <div class="field">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" required>
            </div>
          </div>
          <div class="field">
            <label for="neighborhood">Neighborhood</label>
            <input type="text" id="neighborhood" name="neighborhood" placeholder="e.g. Conway, Belle Isle…">
          </div>
          <div class="field">
            <label for="message">What needs fixing?</label>
            <textarea id="message" name="message" rows="5" placeholder="Describe the job — the more detail the better. Photos welcome when I call you back."></textarea>
          </div>
          <button type="submit" class="btn btn--rust btn--block btn--lg">Send Message</button>
          <p role="status" aria-live="polite" class="form-status"></p>
        </form>
      </div>
    </div>
  </section>
