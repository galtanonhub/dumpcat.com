<section class="cta-band">
  <div class="container">
    <div class="cta-centered">
      <h2>Need a Plumber Today?</h2>
      <p>Same-day service in most cases. Emergency calls dispatched immediately.</p>
      <div class="cta-actions">
        <a href="tel:{{ site.phoneHref }}" class="btn btn--orange btn--lg">Call {{ site.phone }}</a>
        <a href="{{ '/contact/' | url }}" class="btn btn--outline-white">Schedule Online</a>
      </div>
      <div class="cta-badges">
        <span class="cta-badge">Licensed &amp; Insured</span>
        <span class="cta-badge">No Surprise Charges</span>
        <span class="cta-badge">24/7 Emergency Line</span>
        <span class="cta-badge">Free Estimates on Major Work</span>
      </div>
    </div>
  </div>
</section>
