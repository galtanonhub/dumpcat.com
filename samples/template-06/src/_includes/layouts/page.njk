---
layout: layouts/base.njk
---
<div class="page-header">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span> / </span>
      <span aria-current="page">{{ title }}</span>
    </nav>
    <span class="eyebrow eyebrow--white">{{ eyebrow or site.name }}</span>
    <h1>{{ title }}</h1>
    {% if lead %}<p class="page-lead">{{ lead }}</p>{% endif %}
  </div>
</div>

{{ content | safe }}

{% include "partials/cta.njk" %}
