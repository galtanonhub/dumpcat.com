---
permalink: false
layout: layouts/page.njk
title: Customer Reviews
lead: What Central Florida homeowners say about our HVAC work.
eyebrow: Testimonials
---

<section class="section">
  <div class="container">
    <div class="review-grid">
      {% for review in reviews.list %}
      <div class="review-card">
        <div class="review-stars" aria-label="{{ review.stars }} out of 5 stars">{% for i in range(0, review.stars) %}★{% endfor %}</div>
        <p class="review-text">{{ review.text }}</p>
        <p class="review-attr">{{ review.name }} <span>— {{ review.city }}</span></p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
