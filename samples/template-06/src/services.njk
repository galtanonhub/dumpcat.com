---
layout: layouts/page.njk
title: HVAC Services
lead: Complete residential heating and cooling services across Central Florida. Licensed, insured, and honest about what your home needs.
eyebrow: What We Do
permalink: /services/
---

<section class="section">
  <div class="container">
    <div class="services-2col">
      {% for svc in services.list %}
      <div class="svc-card" id="{{ svc.slug }}">
        <div class="svc-card-photo">
          <img src="{{ ('/' + svc.image) | url }}" alt="{{ svc.name }}" loading="lazy">
        </div>
        <div class="svc-card-body">
          <span class="eyebrow eyebrow--dark">Service</span>
          <h2>{{ svc.name }}</h2>
          <p style="color:var(--muted);font-size:1.02rem;line-height:1.8;">{{ svc.long }}</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px;">
            <a href="{{ '/contact/' | url }}" class="btn btn--amber">Request Free Estimate</a>
            <a href="tel:{{ site.phoneHref }}" class="btn btn--outline-amber">Call {{ site.phone }}</a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
