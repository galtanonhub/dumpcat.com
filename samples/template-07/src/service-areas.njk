---
layout: layouts/base.njk
title: Service Areas
permalink: /service-areas/
description: "Residential glass replacement serving Winter Park, Maitland, Oviedo, Lake Mary, Altamonte Springs, and surrounding Central Florida communities."
---

  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Service Areas</span>
      </nav>
      <h1>Where We Work</h1>
      <p class="page-lead">We serve the communities in and around {{ site.city }}. Our coverage area is intentional — staying local keeps our scheduling tight and our prices fair.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="map-embed">
        <iframe src="https://maps.google.com/maps?q=Winter+Park+FL&t=&z=10&ie=UTF8&iwloc=&output=embed" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="county-grid">
        <div class="county-card">
          <strong>Orange County</strong>
          <p>Winter Park, Orlando, Maitland, Apopka, Windermere</p>
        </div>
        <div class="county-card">
          <strong>Seminole County</strong>
          <p>Oviedo, Lake Mary, Casselberry, Longwood, Altamonte Springs</p>
        </div>
        <div class="county-card">
          <strong>Osceola County</strong>
          <p>Kissimmee, St. Cloud, Celebration, Poinciana</p>
        </div>
        <div class="county-card">
          <strong>Surrounding Areas</strong>
          <p>Call to confirm — we're always expanding our coverage</p>
        </div>
      </div>
      <div class="neighborhood-grid">
        {%- for a in areas.list %}
        <div class="neighborhood-item">{{ a }}</div>
        {%- endfor %}
      </div>
      <div class="callout">
        <h3>Don't see your area?</h3>
        <p>Give us a call — our coverage area grows, and we may be able to help depending on where you are.</p>
        <a href="tel:{{ site.phoneHref }}" class="btn btn--slate btn--lg">Call {{ site.phone }}</a>
      </div>
    </div>
  </section>

{% include "partials/cta.njk" %}
