---
layout: layouts/base.njk
title: Our Services
permalink: /services/
description: "Residential glass replacement services: windows, sliding doors, shower enclosures, and mirrors. Central Florida. Licensed & insured."
---

  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">What We Replace</span>
      </nav>
      <h1>What We Replace</h1>
      <p class="page-lead">Every job is measured in person and cut to exact fit. We handle all residential glass — one call covers everything on the list below.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-2col">
        {%- for s in services.list %}
        <div class="svc-card" id="{{ s.slug }}">
          <div class="svc-card-photo">
            <img src="{{ ('/' + s.image) | url }}" alt="{{ s.name }}" loading="lazy">
          </div>
          <div class="svc-card-body">
            <span class="eyebrow">Service</span>
            <h2>{{ s.name }}</h2>
            <div class="section-rule"></div>
            <p>{{ s.tagline }}</p>
            <ul class="detail-list">
              {%- for d in s.details %}
              <li>{{ d }}</li>
              {%- endfor %}
            </ul>
            <a href="{{ '/contact/' | url }}" class="btn btn--slate btn--lg" style="margin-top:8px;">Get a Free Estimate</a>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

{% include "partials/cta.njk" %}
