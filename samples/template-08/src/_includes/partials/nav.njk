  <!-- UTILITY BAR -->
  <div class="util-bar">
    <div class="container util-inner">
      <div class="util-left">
        <a href="tel:{{ site.phoneHref }}" class="util-item">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {{ site.phone }}
        </a>
        <span class="util-item util-divider">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{ site.hours }} &nbsp;|&nbsp; {{ site.hoursNote }}
        </span>
        <span class="util-item">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {{ site.city }}, {{ site.state }}
        </span>
      </div>
      <div class="util-right">
        <a href="mailto:{{ site.email }}" class="util-item">{{ site.email }}</a>
      </div>
    </div>
  </div>

  <!-- MAIN NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="{{ '/' | url }}" class="brand" aria-label="{{ site.name }} home">
        <span class="brand-name">Your Name<em> Remodeling</em></span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="{{ '/services/' | url }}">Our Services</a>
        <a href="{{ '/gallery/' | url }}">Gallery</a>
        <a href="{{ '/service-areas/' | url }}">Service Areas</a>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/contact/' | url }}">Contact</a>
      </nav>

      <a href="tel:{{ site.phoneHref }}" class="nav-phone">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Free Estimate
      </a>

      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
      <a href="{{ '/services/' | url }}">Our Services</a>
      <a href="{{ '/gallery/' | url }}">Gallery</a>
      <a href="{{ '/service-areas/' | url }}">Service Areas</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/contact/' | url }}">Contact</a>
      <a href="tel:{{ site.phoneHref }}" class="btn btn--gold btn--block">Call {{ site.phone }}</a>
    </nav>
  </header>
