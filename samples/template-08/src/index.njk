---
layout: layouts/base.njk
title: "Your Name Remodeling — Bath & Kitchen Specialists"
description: "Full-service bath and kitchen remodeling serving the Tampa Bay area. Licensed & insured. Free in-home estimates."
---

  <!-- HERO: full-bleed background, massive text directly on photo -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="container">
        <span class="hero-eyebrow">Bath &amp; Kitchen Specialists · {{ site.areaServed }}</span>
        <h1>Transform<br>Your Home.</h1>
        <p>{{ site.yearsExp }} years of remodeling experience. Licensed &amp; insured.<br>Free in-home estimates — no pressure, no obligation.</p>
        <a href="{{ '/contact/' | url }}" class="btn btn--gold btn--lg">Get a Free Estimate</a>
      </div>
    </div>
  </section>

  <!-- SERVICE CARDS — overlap the hero -->
  <section class="services-overlap">
    <div class="container">
      <div class="service-cards">
        {%- for s in services.list %}
        <div class="service-card">
          <div class="service-photo">
            <span class="service-photo-icon" aria-hidden="true">{{ s.icon }}</span>
          </div>
          <div class="service-card-body">
            <h3>{{ s.name }}</h3>
            <div class="card-rule"></div>
            <p>{{ s.tagline }}</p>
            <a href="{{ '/services/' | url }}#{{ s.slug }}" class="read-more">Read More →</a>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- GOLD CTA STRIP -->
  <div class="gold-strip">
    <div class="container gold-strip-inner">
      <p>Looking for quality bath &amp; kitchen remodeling in the {{ site.areaServed }} area?</p>
      <a href="{{ '/contact/' | url }}" class="btn btn--outline-dark">Get In Touch</a>
    </div>
  </div>

  <!-- DARK FEATURES SECTION -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head-dark">
        <h2>Why Homeowners Choose Us</h2>
        <div class="section-rule-gold"></div>
      </div>
      <div class="features-grid">
        {%- for f in features.list %}
        <div class="feature-item">
          <div class="feature-icon" aria-hidden="true">
            {%- if loop.index == 1 %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {%- elif loop.index == 2 %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- elif loop.index == 3 %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            {%- elif loop.index == 4 %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {%- elif loop.index == 5 %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- else %}
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            {%- endif %}
          </div>
          <h3>{{ f.title }}</h3>
          <p>{{ f.text }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- GALLERY TEASER -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recent Projects</h2>
        <div class="section-rule"></div>
        <p>A sample of what we've built for homeowners across the {{ site.areaServed }} area.</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-photo gallery-photo--tall">
          <span class="gallery-label">Bathroom Remodel</span>
        </div>
        <div class="gallery-photo">
          <span class="gallery-label">Kitchen Remodel</span>
        </div>
        <div class="gallery-photo">
          <span class="gallery-label">Custom Tile</span>
        </div>
        <div class="gallery-photo gallery-photo--tall">
          <span class="gallery-label">Master Bath</span>
        </div>
        <div class="gallery-photo">
          <span class="gallery-label">Custom Cabinetry</span>
        </div>
        <div class="gallery-photo">
          <span class="gallery-label">Kitchen Renovation</span>
        </div>
      </div>
      <div class="center" style="margin-top:36px;">
        <a href="{{ '/gallery/' | url }}" class="btn btn--dark btn--lg">View Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section section--light">
    <div class="container">
      <div class="section-head">
        <h2>What Our Customers Say</h2>
        <div class="section-rule"></div>
      </div>
      <div class="review-grid">
        {%- for r in reviews.list | limit(3) %}
        <div class="review-card">
          <div class="review-stars" aria-label="{{ r.stars }} out of 5">{% for i in range(0, r.stars) %}★{% endfor %}</div>
          <p class="review-text">"{{ r.text }}"</p>
          <div class="review-byline">{{ r.name }} <span>— {{ r.city }}</span></div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head-dark">
        <span class="eyebrow-light">Where We Work</span>
        <h2>{{ site.areaServed }} &amp; Surrounding Communities</h2>
        <div class="section-rule-gold"></div>
      </div>
      <ul class="neighborhood-list">
        {%- for a in areas.list %}
        <li>{{ a }}</li>
        {%- endfor %}
      </ul>
      <div class="center">
        <a href="{{ '/service-areas/' | url }}" class="link-arrow link-arrow--gold">See Full Coverage Area</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Frequently Asked Questions</h2>
        <div class="section-rule"></div>
      </div>
      <div class="faq-list">
        {%- for item in faq.list %}
        <div class="faq-item">
          <h3 class="faq-q">{{ item.q }}</h3>
          <p class="faq-a">{{ item.a }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

{% include "partials/cta.njk" %}
