      <div class="county-grid">
        <div class="county-card">
          <h3>Hillsborough County</h3>
          <p>Tampa, Brandon, Riverview, Lutz, Land O Lakes, Temple Terrace, Plant City</p>
        </div>
        <div class="county-card">
          <h3>Pinellas County</h3>
          <p>St. Petersburg, Clearwater, Dunedin, Safety Harbor, Palm Harbor, Largo, Tarpon Springs</p>
        </div>
        <div class="county-card">
