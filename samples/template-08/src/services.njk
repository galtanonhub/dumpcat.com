---
layout: layouts/base.njk
title: Our Services
permalink: /services/
description: "Bath and kitchen remodeling services: bathroom renovation, kitchen remodeling, tile & flooring, custom cabinetry. Tampa Bay area."
---

  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Our Services</span>
      </nav>
      <h1>Our Services</h1>
      <p class="page-lead">Full-service bath and kitchen remodeling — from a single fixture upgrade to a complete gut renovation. All work is permitted, warrantied, and done by our own crew.</p>
    </div>
  </section>

  {%- for s in services.list %}
  <section class="section {% if loop.index is even %}section--light{% endif %}" id="{{ s.slug }}">
    <div class="container">
      <div class="service-detail">
        <div class="service-detail-photo">
          <div class="service-photo service-photo--lg">
            <span class="service-photo-icon service-photo-icon--lg" aria-hidden="true">{{ s.icon }}</span>
          </div>
        </div>
        <div class="service-detail-copy">
          <span class="eyebrow">Service</span>
          <h2>{{ s.name }}</h2>
          <div class="section-rule" style="margin:12px 0 20px;"></div>
          <p>{{ s.tagline }}</p>
          <ul class="detail-list">
            {%- for d in s.details %}
            <li>{{ d }}</li>
            {%- endfor %}
          </ul>
          <a href="{{ '/contact/' | url }}" class="btn btn--dark btn--lg" style="margin-top:8px;">Get a Free Estimate</a>
        </div>
      </div>
    </div>
  </section>
  {%- endfor %}

{% include "partials/cta.njk" %}
